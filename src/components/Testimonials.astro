---
interface Testimonial {
  data: {
    quote: string;
    name: string;
    role?: string;
  };
}

interface Props {
  testimonials: Testimonial[];
  variant?: 'grid' | 'stacked';
}

const { testimonials, variant = 'grid' } = Astro.props;
const isCarousel = testimonials.length > 1;
---

{isCarousel ? (
  <div class="testimonial-carousel" id="testimonial-carousel">
    <div class="testimonial-carousel__track">
      {testimonials.map((item, i) => (
        <figure
          class="testimonial-carousel__slide"
          class:list={{ 'testimonial-carousel__slide--active': i === 0 }}
        >
          <blockquote>{item.data.quote}</blockquote>
          <figcaption>
            <strong>{item.data.name}</strong>
            {item.data.role && <span>{item.data.role}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="testimonial-carousel__dots" aria-hidden="true">
      {testimonials.map((_, i) => (
        <button
          type="button"
          class="testimonial-carousel__dot"
          class:list={{ 'testimonial-carousel__dot--active': i === 0 }}
          data-index={i}
          aria-label={`Testimonial ${i + 1}`}
        ></button>
      ))}
    </div>
  </div>
) : (
  <div class:list={['testimonials', `testimonials--${variant}`]}>
    {testimonials.map((item) => (
      <figure>
        <blockquote>{item.data.quote}</blockquote>
        <figcaption>
          <strong>{item.data.name}</strong>
          {item.data.role && <span>{item.data.role}</span>}
        </figcaption>
      </figure>
    ))}
  </div>
)}

<style>
  .testimonials {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .testimonials--stacked {
    grid-template-columns: 1fr;
    max-width: var(--container-narrow);
  }

  figure {
    margin: 0;
    padding: var(--space-5);
    border-left: 3px solid var(--brand-primary);
    background: var(--color-page);
  }

  blockquote {
    margin: 0 0 var(--space-5);
    color: var(--color-text);
    font-size: var(--text-md);
    line-height: 1.55;
  }

  figcaption {
    display: grid;
    gap: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  figcaption strong {
    color: var(--color-text);
  }

  /* --- Carousel --- */

  .testimonial-carousel {
    position: relative;
    max-width: 48rem;
    margin: 0 auto;
  }

  .testimonial-carousel__track {
    position: relative;
    overflow: hidden;
  }

  .testimonial-carousel__slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    margin: 0;
    padding: var(--space-5);
    border-left: 3px solid var(--brand-primary);
    background: var(--color-page);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .testimonial-carousel__slide--active {
    opacity: 1;
    visibility: visible;
  }

  .testimonial-carousel__dots {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .testimonial-carousel__dot {
    width: 10px;
    height: 10px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--color-rule);
    cursor: pointer;
    transition: background 0.25s ease;
  }

  .testimonial-carousel__dot--active {
    background: var(--brand-primary);
  }

  .testimonial-carousel__dot:hover {
    background: var(--brand-primary);
    opacity: 0.7;
  }

  @media (max-width: 760px) {
    .testimonials {
      grid-template-columns: 1fr;
    }

    .testimonial-carousel {
      max-width: 100%;
    }
  }
</style>

{isCarousel && (
  <script>
    (function () {
      const container = document.getElementById('testimonial-carousel');
      if (!container) return;

      const slides = container.querySelectorAll('.testimonial-carousel__slide');
      const dots = container.querySelectorAll('.testimonial-carousel__dot');
      const track = container.querySelector('.testimonial-carousel__track');
      let current = 0;
      let interval;

      // Fix height to tallest slide to prevent layout shift
      let maxH = 0;
      slides.forEach((s) => {
        s.style.position = 'absolute';
        s.style.opacity = '1';
        s.style.visibility = 'visible';
        const h = s.offsetHeight;
        if (h > maxH) maxH = h;
        // Reset inline styles so CSS class takes over
        s.style.position = '';
        s.style.opacity = '';
        s.style.visibility = '';
      });
      track.style.minHeight = maxH + 'px';

      function show(index) {
        slides[current].classList.remove('testimonial-carousel__slide--active');
        dots[current].classList.remove('testimonial-carousel__dot--active');
        current = (index + slides.length) % slides.length;
        slides[current].classList.add('testimonial-carousel__slide--active');
        dots[current].classList.add('testimonial-carousel__dot--active');
      }

      function next() { show(current + 1); }

      function start() { interval = setInterval(next, 5000); }
      function stop() { clearInterval(interval); }

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          stop();
          show(parseInt(dot.dataset.index));
          start();
        });
      });

      container.addEventListener('mouseenter', stop);
      container.addEventListener('mouseleave', start);

      start();
    })();
  </script>
)}
