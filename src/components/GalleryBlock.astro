---
interface Props {
  items?: Array<{ title: string; description?: string; imageUrl?: string }>;
  variant?: 'grid' | 'feature-left' | 'feature-right' | 'portfolio' | 'showcase';
}

const {
  variant = 'grid',
  items = [
    { title: 'Project image', description: 'Swap this placeholder for client photography.' },
    { title: 'Detail image', description: 'Use captions when context matters.' },
    { title: 'Team image', description: 'Keep image treatment simple and consistent.' }
  ]
} = Astro.props;

const portfolioItems = items.length >= 4
  ? items
  : [
    { title: 'Period Cornice Restore', description: 'Ornamental plaster, Hawthorn', imageUrl: '/melbourne-plastering/uploads/service-heritage.jpg' },
    { title: 'Vaulted Ceiling Finish', description: 'Open-plan living, Toorak', imageUrl: '/melbourne-plastering/uploads/gallery-vaulted.jpg' },
    { title: 'Exterior Rendering', description: 'Modern residence, Brighton', imageUrl: '/melbourne-plastering/uploads/gallery-exterior.jpg' },
    { title: 'Modern Living Space', description: 'Split-level renovation, Fitzroy', imageUrl: '/melbourne-plastering/uploads/gallery-hero.jpg' }
  ];
---

{variant === 'portfolio' ? (
  <div class="gallery-block gallery-block--portfolio">
    <div class="portfolio-track">
      {portfolioItems.map((item) => (
        <figure class="portfolio-card">
      {item.imageUrl ? (
            <div class="portfolio-card__img-wrap"><img src={item.imageUrl} alt={item.title} loading="lazy" /></div>
          ) : (
            <div aria-hidden="true"></div>
          )}
          <figcaption>
            <strong>{item.title}</strong>
            {item.description && <span>{item.description}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
) : variant === 'showcase' ? (
  <div class="gallery-showcase" id="gallery-showcase">
    <div class="gallery-showcase__main">
      {portfolioItems.map((item, i) => (
        <figure
          class="gallery-showcase__slide"
          class:list={{ 'gallery-showcase__slide--active': i === 0 }}
          data-index={i}
        >
          <img src={item.imageUrl} alt={item.title} />
          <figcaption>
            <strong>{item.title}</strong>
            {item.description && <span>{item.description}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="gallery-showcase__thumbs" role="tablist" aria-label="Gallery images">
      {portfolioItems.map((item, i) => (
        <button
          type="button"
          class="gallery-showcase__thumb"
          class:list={{ 'gallery-showcase__thumb--active': i === 0 }}
          data-index={i}
          role="tab"
          aria-selected={i === 0}
          aria-label={`View ${item.title}`}
        >
          <img src={item.imageUrl} alt="" aria-hidden="true" loading="lazy" />
        </button>
      ))}
    </div>
  </div>
) : (
  <div class:list={['gallery-block', `gallery-block--${variant}`]}>
    {items.map((item) => (
      <figure>
        <div aria-hidden="true"></div>
        <figcaption>
          <strong>{item.title}</strong>
          {item.description && <span>{item.description}</span>}
        </figcaption>
      </figure>
    ))}
  </div>
) }

<style>
  .gallery-block {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .gallery-block--feature-left,
  .gallery-block--feature-right {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
  }

  .gallery-block--feature-right {
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
  }

  .gallery-block--feature-left figure:first-child,
  .gallery-block--feature-right figure:first-child {
    grid-row: span 2;
  }

  .gallery-block--feature-right figure:first-child {
    order: 2;
  }

  .gallery-block--feature-left figure:first-child > div,
  .gallery-block--feature-right figure:first-child > div {
    aspect-ratio: 4 / 4.9;
  }

  figure {
    margin: 0;
  }

  figure > div {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    background:
      linear-gradient(135deg, transparent 49%, var(--color-rule) 50%, transparent 51%),
      linear-gradient(45deg, transparent 49%, var(--color-rule) 50%, transparent 51%),
      var(--color-section);
  }

  figcaption {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  figcaption strong {
    color: var(--color-text);
  }

  /* --- portfolio variant --- */

  .gallery-block--portfolio {
    display: block;
  }

  .portfolio-track {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .portfolio-card {
    margin: 0;
  }

  .portfolio-card > div,
  .portfolio-card > .portfolio-card__img-wrap {
    aspect-ratio: 3 / 4;
    border: none;
    border-radius: var(--radius-xs);
  }

  .portfolio-card > div {
    background:
      linear-gradient(135deg, transparent 48%, var(--color-rule) 49%, transparent 51%),
      linear-gradient(45deg, transparent 48%, var(--color-rule) 49%, transparent 51%),
      var(--color-section);
  }

  .portfolio-card__img-wrap {
    overflow: hidden;
  }

  .portfolio-card__img-wrap > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .portfolio-card:nth-child(1) > .portfolio-card__img-wrap,
  .portfolio-card:nth-child(2) > .portfolio-card__img-wrap,
  .portfolio-card:nth-child(3) > .portfolio-card__img-wrap,
  .portfolio-card:nth-child(4) > .portfolio-card__img-wrap {
    background: var(--color-section);
  }

  .portfolio-card figcaption {
    margin-top: var(--space-3);
  }

  /* --- showcase variant (feature image + thumbnails) --- */

  .gallery-showcase {
    max-width: var(--container-narrow);
    margin: 0 auto;
  }

  .gallery-showcase__main {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-section);
  }

  .gallery-showcase__slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .gallery-showcase__slide--active {
    position: relative;
    opacity: 1;
    visibility: visible;
  }

  .gallery-showcase__slide img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .gallery-showcase__slide figcaption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    margin: 0;
    padding: var(--space-5);
    background: linear-gradient(transparent, rgba(0,0,0,0.7));
    color: #fff;
    border: none;
  }

  .gallery-showcase__slide figcaption strong {
    color: #fff;
  }

  .gallery-showcase__slide figcaption span {
    color: rgba(255,255,255,0.75);
  }

  .gallery-showcase__thumbs {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
    overflow-x: auto;
    padding-bottom: var(--space-1);
  }

  .gallery-showcase__thumb {
    flex: 0 0 auto;
    width: 80px;
    height: 60px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--radius-xs);
    background: none;
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.25s ease, opacity 0.25s ease;
    opacity: 0.6;
  }

  .gallery-showcase__thumb:hover {
    opacity: 0.85;
  }

  .gallery-showcase__thumb--active {
    border-color: var(--color-gold);
    opacity: 1;
  }

  .gallery-showcase__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 760px) {
    .gallery-block {
      grid-template-columns: 1fr;
    }

    .gallery-block--feature-left figure:first-child,
    .gallery-block--feature-right figure:first-child {
      grid-row: auto;
      order: initial;
    }

    .gallery-block--feature-left figure:first-child > div,
    .gallery-block--feature-right figure:first-child > div {
      aspect-ratio: 4 / 3;
    }

    .portfolio-track {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .portfolio-card > div {
      aspect-ratio: 3 / 4;
    }

    .gallery-showcase__slide img {
      aspect-ratio: 4 / 3;
    }

    .gallery-showcase__thumb {
      width: 64px;
      height: 48px;
    }
  }

  @media (max-width: 480px) {
    .portfolio-track {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

{variant === 'showcase' && (
  <script>
    (function () {
      const container = document.getElementById('gallery-showcase');
      if (!container) return;

      const slides = container.querySelectorAll('.gallery-showcase__slide');
      const thumbs = container.querySelectorAll('.gallery-showcase__thumb');
      const main = container.querySelector('.gallery-showcase__main');
      let current = 0;
      let interval;

      // Fix height to prevent layout shift
      let maxH = 0;
      slides.forEach((s) => {
        s.style.position = 'absolute';
        s.style.opacity = '1';
        s.style.visibility = 'visible';
        const h = s.offsetHeight;
        if (h > maxH) maxH = h;
        s.style.position = '';
        s.style.opacity = '';
        s.style.visibility = '';
      });
      main.style.minHeight = maxH + 'px';

      function show(index) {
        slides[current].classList.remove('gallery-showcase__slide--active');
        thumbs[current].classList.remove('gallery-showcase__thumb--active');
        thumbs[current].setAttribute('aria-selected', 'false');
        current = (index + slides.length) % slides.length;
        slides[current].classList.add('gallery-showcase__slide--active');
        thumbs[current].classList.add('gallery-showcase__thumb--active');
        thumbs[current].setAttribute('aria-selected', 'true');
      }

      function next() { show(current + 1); }

      function start() { interval = setInterval(next, 5000); }
      function stop() { clearInterval(interval); }

      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => {
          stop();
          show(parseInt(thumb.dataset.index));
          start();
        });
      });

      container.addEventListener('mouseenter', stop);
      container.addEventListener('mouseleave', start);

      start();
    })();
  </script>
)}
