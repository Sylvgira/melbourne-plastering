---
interface Service {
  id?: string;
  data: {
    title: string;
    summary: string;
    image?: string;
  };
}

interface Props {
  services: Service[];
}

const { services } = Astro.props;
const pathFor = (service: Service) => `/services/${service.id}/`;
---

<div class="service-image-grid">
  {services.map((service) => (
    <a class="service-image-card" href={pathFor(service)}>
      {service.data.image ? (
        <img
          class="service-image-card__bg"
          src={service.data.image}
          alt=""
          loading="lazy"
          aria-hidden="true"
        />
      ) : null}
      <div class="service-image-card__overlay"></div>
      <div class="service-image-card__content">
        <h3>{service.data.title}</h3>
        <p>{service.data.summary}</p>
      </div>
    </a>
  ))}
</div>

<style>
  .service-image-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .service-image-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 18rem;
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    color: #ffffff;
    isolation: isolate;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .service-image-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
  }

  .service-image-card__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    transition: transform 0.4s ease;
  }

  .service-image-card:hover .service-image-card__bg {
    transform: scale(1.05);
  }

  .service-image-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(10, 10, 30, 0.85) 0%,
      rgba(10, 10, 30, 0.4) 40%,
      rgba(10, 10, 30, 0.15) 100%
    );
  }

  .service-image-card__content {
    position: relative;
    z-index: 2;
    padding: var(--space-5);
  }

  .service-image-card h3 {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 700;
    color: #ffffff;
    letter-spacing: normal;
    text-transform: none;
  }

  .service-image-card p {
    margin: 0;
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.55;
  }

  @media (max-width: 860px) {
    .service-image-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 540px) {
    .service-image-grid {
      grid-template-columns: 1fr;
    }

    .service-image-card {
      min-height: 14rem;
    }
  }
</style>
