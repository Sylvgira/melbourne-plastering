---
interface Props {
  site: {
    name: string;
    email?: string;
    phone?: string;
    address?: string;
    socialLinks?: Array<{ label: string; url: string }>;
  };
  variant?: 'default' | 'dark';
}

const { site, variant = 'dark' } = Astro.props;
const year = new Date().getFullYear();
const isDark = variant === 'dark';
---

<footer class:list={['site-footer', isDark && 'site-footer--dark']}>
  <div class="site-footer__top container">
    <div class="site-footer__brand-col">
      <a class="site-footer__brand" href="/">
        <span class="brand-lockup">
          <span class="brand-lockup__primary">
            <span class="brand-lockup__city">Melbourne</span>
            <span class="brand-lockup__trade">Plastering</span>
          </span>
          <span class="brand-lockup__sub">&amp; Building Maintenance</span>
        </span>
      </a>
      <p class="site-footer__tagline">Melbourne's heritage plastering specialists. 30 years of craftsmanship — call Mark for a free quote.</p>
    </div>
    <div class="site-footer__links-col">
      <div class="site-footer__link-group">
        <h2>Explore</h2>
        <a href="/services/">Services</a>
        <a href="/#testimonials">Testimonials</a>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
      </div>
      <div class="site-footer__link-group">
        <h2>Contact</h2>
        {site.phone && (
          <a href={`tel:${site.phone}`}>
            <span class="site-footer__icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </span>
            {site.phone}
          </a>
        )}
        {site.email && (
          <a href={`mailto:${site.email}`}>
            <span class="site-footer__icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </span>
            {site.email}
          </a>
        )}
        {site.address && (
          <p>
            <span class="site-footer__icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            {site.address}
          </p>
        )}
      </div>
      <div class="site-footer__link-group">
        <h2>Social</h2>
        <div class="site-footer__social-links">
          {site.socialLinks && site.socialLinks.map((link) => (
            <a href={link.url} class="site-footer__social-link">
              <span class="site-footer__icon" aria-hidden="true">
                {link.label.toLowerCase().includes('facebook') && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                )}
                {link.label.toLowerCase().includes('instagram') && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                )}
                {!link.label.toLowerCase().includes('facebook') && !link.label.toLowerCase().includes('instagram') && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                )}
              </span>
              {link.label}
            </a>
          ))}
          {(!site.socialLinks || site.socialLinks.length === 0) && (
            <>
              <a href="#" class="site-footer__social-link">
                <span class="site-footer__icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                </span>
                Facebook
              </a>
              <a href="#" class="site-footer__social-link">
                <span class="site-footer__icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                </span>
                Instagram
              </a>
            </>
          )}
        </div>
      </div>
    </div>
  </div>
  <div class="site-footer__meta container">
    <span>&copy; {year} {site.name}</span>
    <a href="/privacy/">Privacy</a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-rule);
    background: var(--color-section);
  }

  .site-footer--dark {
    border-top: none;
    background: var(--brand-primary);
    color: #ffffff;
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: var(--space-8);
    padding-block: var(--section-y-compact);
  }

  .site-footer__brand-col {
    display: flex;
    flex-direction: column;
  }

  .site-footer__brand {
    display: inline-block;
    margin-bottom: var(--space-3);
    text-decoration: none;
  }

  .site-footer--dark .site-footer__brand {
    color: #ffffff;
  }

  .site-footer--dark .brand-lockup__city {
    color: var(--color-gold);
  }

  .site-footer--dark .brand-lockup__trade {
    color: #ffffff;
  }

  .site-footer--dark .brand-lockup__sub {
    color: rgba(255, 255, 255, 0.65);
  }

  .brand-lockup {
    display: inline-grid;
    grid-template-columns: auto auto;
    line-height: 1.1;
  }

  .brand-lockup__primary {
    grid-column: 1 / -1;
    display: flex;
    gap: 0.35em;
    font-weight: 800;
    font-size: 1.25rem;
  }

  .brand-lockup__city {
    color: var(--brand-primary);
  }

  .brand-lockup__trade {
    color: var(--color-ink);
  }

  .brand-lockup__sub {
    grid-column: 2;
    justify-self: start;
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--color-muted);
    letter-spacing: 0.02em;
    margin-top: -0.05em;
    white-space: nowrap;
  }

  .site-footer__tagline {
    max-width: 28rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .site-footer--dark .site-footer__tagline {
    color: rgba(255, 255, 255, 0.7);
  }

  .site-footer__links-col {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .site-footer__link-group {
    display: flex;
    flex-direction: column;
  }

  .site-footer h2 {
    margin-bottom: var(--space-3);
    font-size: var(--text-sm);
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-text-muted);
    letter-spacing: normal;
    text-transform: none;
  }

  .site-footer--dark h2 {
    color: rgba(255, 255, 255, 0.55);
  }

  .site-footer a {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: fit-content;
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    word-break: break-all;
    transition: color 0.2s ease;
  }

  .site-footer--dark a {
    color: rgba(255, 255, 255, 0.75);
  }

  .site-footer--dark a:hover {
    color: #ffffff;
  }

  .site-footer__icon {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .site-footer--dark .site-footer__icon {
    opacity: 0.65;
  }

  .site-footer--dark a:hover .site-footer__icon {
    opacity: 1;
  }

  .site-footer__social-links {
    display: flex;
    flex-direction: column;
  }

  .site-footer__social-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .site-footer p {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .site-footer--dark p {
    color: rgba(255, 255, 255, 0.65);
  }

  .site-footer__meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-rule);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .site-footer__meta a {
    margin: 0;
  }

  .site-footer--dark .site-footer__meta {
    border-top-color: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.45);
  }

  .site-footer--dark .site-footer__meta a {
    color: rgba(255, 255, 255, 0.45);
  }

  .site-footer--dark .site-footer__meta a:hover {
    color: #ffffff;
  }

  @media (max-width: 760px) {
    .site-footer__top,
    .site-footer__links-col {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .site-footer__meta {
      flex-direction: column;
    }
  }
</style>
